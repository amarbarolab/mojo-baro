#!/usr/bin/env bash
# baro: run or verify a self-describing BARO gguf (B1, docs/NEXT-PLAN.md).
#
#   tools/baro run     MODEL.gguf [--port N] [--chat-template-file PATH] [--pack DIR] [--work DIR] [--no-serve]
#   tools/baro verify  MODEL.gguf [--append] [--work DIR]
#   tools/baro receipts MODEL.gguf
#   tools/baro serve   MODEL.gguf [--port N] [--chat-template-file PATH] [--rebuild]
#   tools/baro eval    MODEL-KEY [--quick N] [--dry-run]
#   tools/baro eval-all [MODEL-KEY ...]
#   tools/baro multi-serve MODEL.gguf [--devices 0,1] [--port N]
#
# THREE MODES.
#
# serve mode is run mode plus a persistent cache (item 4, briefs/2026-09-16-
# baro-serve-cache-lane.md): the engine binary and weight pack are built once
# per structural id (tools/model-id.py hashes exactly what serve/engine.mojo
# or serve/spark.mojo compiles in for this checkpoint's shape, read from the
# GGUF header only) and reused by every later `baro serve` of a same-shape
# checkpoint, at $BARO_CACHE (default ~/.cache/baro)/<id>/{engine,manifest.json,
# packs/<gguf-sha256>/}. Packs are keyed by id + the GGUF's own sha256 (never
# just id) because weights differ per checkpoint even at one shape. Eviction
# is manual, not automatic: `rm -rf ~/.cache/baro/<id>` drops an engine and
# every pack built under it; `rm -rf ~/.cache/baro/<id>/packs/<sha>` drops one
# pack and keeps the compiled engine.
#
# run/verify: TWO MODES, and the difference between them is the whole point.
#
# run mode extracts the sources the file carries, builds the engine with the
# harness the file carries (baro.run.src.engine.mojo), builds the weight pack
# from the file itself, and serves it. It needs no reference tokens and no
# checkout of this repo beyond this script. Every number it prints is labelled
# "self-reported": the file supplied the stopwatch, so the file cannot be timed
# by it (exchange/scorer-integrity-report.md P-A).
#
# verify mode does the opposite. It takes serve/engine.mojo from git at the
# file's own baro.kernel.commit, refuses to continue if the harness the file
# carries differs from it by one byte, then runs tools/gguf-verify.sh (rebuild
# from the embedded kernel sources, gate the tokens, print the hardware
# receipt). Only verify mode may append to the receipt ledger, and every
# receipt it writes carries mode=verified and the commit it was checked
# against. It needs the checkout, by design.
#
# The ledger lives in tools/gguf-receipt.py: a sidecar JSONL next to the model
# by default, or inside the file's baro.hw.receipts key with --in-file (which
# rewrites the whole gguf, so it is opt-in).
set -uo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)

die() { echo "baro: $*" >&2; exit 1; }
kvget() { jq -r --arg k "$1" '.[$k] // empty' "$meta"; }

cmd=${1:-}; shift || true
[ -n "$cmd" ] || die "usage: baro {serve|run|verify|receipts|eval|multi-serve} MODEL.gguf [options]"

case $cmd in
eval)
  key=${1:-}; shift || true
  [ -n "$key" ] || die "usage: baro eval MODEL-KEY [--quick N] [--dry-run]"
  quick=0; dry=0
  while [ $# -gt 0 ]; do
    case $1 in
      --quick) quick=$2; shift 2;;
      --dry-run) dry=1; shift;;
      *) die "unknown eval option $1";;
    esac
  done
  jq -e --arg key "$key" '.[$key] and ($key | startswith("_") | not)' "$here/bench/quality-models.json" >/dev/null \
    || die "unknown quality model key $key"
  if [ "$dry" = 1 ]; then
    echo "baro eval: bench/quality-run.sh $key QUICK=$quick"
    exit 0
  fi
  exec env QUICK="$quick" "$here/bench/quality-run.sh" "$key"
  ;;
eval-all)
  exec "$here/bench/quality-sweep.sh" "$@"
  ;;
multi-serve)
  exec "$here/tools/baro-multi-serve" "$@"
  ;;
esac

model=${1:-}; shift || true
[ -n "$model" ] && [ -f "$model" ] || die "no such model file: ${model:-<none>}"
model=$(readlink -f "$model")

port=8080; pack=""; work=""; append=0; serve=1; rebuild=0; chat_template_file=""
while [ $# -gt 0 ]; do
  case $1 in
    --port) port=$2; shift 2;;
    --pack) pack=$(readlink -f "$2"); shift 2;;
    --work) work=$2; shift 2;;
    --append) append=1; shift;;
    --no-serve) serve=0; shift;;
    --rebuild) rebuild=1; shift;;
    --chat-template-file) chat_template_file=$(readlink -f "$2"); shift 2;;
    *) die "unknown option $1";;
  esac
done
work=${work:-$here/.work/baro-$(basename "${model%.gguf}")}
mkdir -p "$work"
meta=$work/meta.json

# The metadata read is the same for every mode. gguf-extract.py is this repo's
# reader; ~/iTools/bin/gguf-kv is the one-line alternative but does not emit
# the source KVs as JSON.
py=$here/.venv/bin/python3
[ -x "$py" ] || py=python3
"$py" "$here/tools/gguf-extract.py" "$model" --meta > "$meta" || die "cannot read $model"
commit=$(kvget baro.kernel.commit)
kmodel=$(kvget baro.kernel.model)
[ -n "$commit" ] || die "not a BARO file: no baro.kernel.commit"

case $cmd in

receipts)
  exec "$py" "$here/tools/gguf-receipt.py" "$model" --list
  ;;

verify)
  # 1. the harness check. A file whose embedded harness differs from git at its
  #    own commit has either been tampered with or was baked from a dirty tree;
  #    either way its numbers describe an engine nobody can review.
  esha=$(kvget baro.run.harness.sha)
  if [ -n "$esha" ]; then
    hpath=$(kvget baro.run.harness.path); hpath=${hpath:-serve/engine.mojo}
    git -C "$here" cat-file -e "$commit:$hpath" 2>/dev/null \
      || die "commit $commit is not in this checkout, so the harness ($hpath) cannot be checked"
    gsha=$(git -C "$here" show "$commit:$hpath" | sha256sum | cut -d' ' -f1)
    if [ "$esha" != "$gsha" ]; then
      echo "HARNESS MISMATCH" >&2
      echo "  embedded baro.run.harness.sha: $esha" >&2
      echo "  git $commit:$hpath:  $gsha" >&2
      die "the file carries a harness that is not the one at its own commit; its numbers are not verifiable"
    fi
    echo "harness: embedded copy is byte-identical to $hpath at $commit ($gsha)"
  else
    echo "harness: file carries no baro.run.src.engine.mojo (pre-B1 bake); verify uses git only"
  fi

  # 2. the real check: rebuild from the file's kernel sources and gate tokens.
  out=$work/verify
  "$here/tools/gguf-verify.sh" "$model" "$out" 2>&1 | tee "$work/verify.log"
  rc=${PIPESTATUS[0]}
  echo "verify exit: $rc"
  [ $rc = 0 ] || die "verification FAILED (exit $rc); no receipt written"

  if [ $append = 1 ]; then
    tps=$(grep -oE 'tok/s_gen: [0-9.]+' "$out/run.log" 2>/dev/null | tail -1 | cut -d' ' -f2)
    card=$(rocminfo 2>/dev/null | grep -m1 -oE 'gfx[0-9a-f]+')
    # product_name is empty on this driver, so the GPU's marketing name comes
    # from rocminfo (the second one: the first is the CPU agent).
    name=$(cat /sys/class/drm/card*/device/product_name 2>/dev/null | grep -v '^$' | head -1)
    [ -n "$name" ] || name=$(rocminfo 2>/dev/null | awk '/Marketing Name/ {sub(/^ *Marketing Name: */, ""); sub(/ *$/, ""); print}' | sed -n 2p)
    cap=$(cat /sys/class/drm/card1/device/hwmon/hwmon*/power1_cap 2>/dev/null | head -1)
    "$py" "$here/tools/gguf-receipt.py" "$model" --append "$(jq -nc \
      --arg mode verified --arg commit "$commit" --arg gfx "${card:-unknown}" \
      --arg card "${name:-unknown}" --arg rocm "$(cat /opt/rocm/.info/version 2>/dev/null)" \
      --arg driver "$(cat /sys/module/amdgpu/version 2>/dev/null || uname -r)" \
      --arg cap_w "$(( ${cap:-0} / 1000000 ))" --arg tok_s_gen "${tps:-}" \
      --arg date "$(date -Is)" --arg host "$(hostname)" \
      '{mode:$mode, checked_against_commit:$commit, gfx:$gfx, card:$card, rocm:$rocm,
        driver:$driver, power_cap_w:($cap_w|tonumber), tok_s_gen_one_prompt:$tok_s_gen,
        date:$date, host:$host}')"
  fi
  ;;

serve)
  t0=$(date +%s)
  idjson=$("$py" "$here/tools/model-id.py" "$model" --json 2>"$work/model-id.err") || die "$(cat "$work/model-id.err")"
  echo "$idjson" > "$work/model-id.json"
  id=$(jq -r .id <<<"$idjson")
  cache=${BARO_CACHE:-$HOME/.cache/baro}/$id
  mkdir -p "$cache"
  echo "id: $id"

  hpath=$(kvget baro.run.harness.path); hpath=${hpath:-serve/engine.mojo}
  hname=$(basename "$hpath")

  built=0
  if [ "$rebuild" = 1 ] || [ ! -x "$cache/engine" ]; then
    built=1
    ebuild0=$(date +%s)
    src=$cache/src
    rm -rf "$src"; mkdir -p "$src"
    jq -r '.["baro.kernel.files"]' "$meta" | tr ',' '\n' > "$src/FILES"
    while read -r fname; do
      [ -n "$fname" ] || continue
      mkdir -p "$src/$(dirname "$fname")"
      jq -r --arg k "baro.kernel.src.$fname" '.[$k]' "$meta" > "$src/$fname"
    done < "$src/FILES"
    # The harness itself, named from baro.run.harness.path -- engine.mojo for
    # qwen35/qwen35moe, spark.mojo for llama/qwen2/granite/spark2_5 (item 3).
    # `tools/baro run` hardcodes baro.run.src.engine.mojo and so cannot build
    # a spark-harness bake self-contained; this reads the file's own name
    # instead, since it is written right alongside the source (tools/gguf-
    # embed.py --run-harness).
    harness=$(jq -r --arg k "baro.run.src.$hname" '.[$k] // empty' "$meta")
    [ -n "$harness" ] || die "this file carries no baro.run.src.$hname (harness path $hpath); re-bake with --run-harness=$hpath or use: baro verify $model"
    printf '%s' "$harness" > "$src/$hname"
    for k in $(jq -r 'keys[] | select(startswith("baro.run.src.")) | select(endswith(".mojo"))' "$meta"); do
      n=${k#baro.run.src.}
      [ "$n" = "$hname" ] && continue
      jq -r --arg k "$k" '.[$k]' "$meta" > "$src/$n"
    done

    mojo=$here/.venv/bin/mojo
    [ -x "$mojo" ] || die "no $mojo; run 'uv sync' in the checkout first (the pinned toolchain is max[all]==26.5.0)"
    dflag=""
    [ "$hname" = "engine.mojo" ] && [ -n "$kmodel" ] && dflag="-D BARO_MODEL=$kmodel"
    echo "building engine ($hpath${dflag:+, $dflag}) ..."
    # shellcheck disable=SC2086
    "$mojo" build "$src/$hname" -I "$src" $dflag -o "$cache/engine.new" > "$cache/build.log" 2>&1
    [ -x "$cache/engine.new" ] || { grep -m3 error "$cache/build.log"; die "engine build FAILED, see $cache/build.log"; }
    mv -f "$cache/engine.new" "$cache/engine"
    ebuild_s=$(( $(date +%s) - ebuild0 ))
    echo "engine: built in ${ebuild_s}s -> $cache/engine"
    "$py" - "$work/model-id.json" "$model" "$commit" "$hpath" "${dflag:-none}" "$ebuild_s" <<'PYEOF' > "$cache/manifest.json"
import json, sys, time
idjson_path, model, commit, harness, flags, secs = sys.argv[1:7]
idjson = json.load(open(idjson_path))
json.dump({
    "id": idjson["id"], "arch": idjson["arch"], "engine_family": idjson["engine"],
    "id_fields": idjson["fields"], "harness": harness, "build_flags": flags,
    "mojo_baro_commit": commit, "built_from": model,
    "built_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "build_seconds": int(secs),
}, sys.stdout, indent=1)
PYEOF
  fi
  echo "engine: $([ $built = 1 ] && echo miss || echo hit) $cache/engine"

  # GGUF sha (item 2: packs keyed by id + the checkpoint's own weights, never
  # just id), cached by (path, size, mtime) so a warm `baro serve` never
  # re-hashes a multi-GB file it already hashed this box.
  shacache=${BARO_CACHE:-$HOME/.cache/baro}/sha-cache.tsv
  touch "$shacache"
  statkey=$(stat -c '%s %Y' "$model")
  gsha=$(awk -v m="$model" -v k="$statkey" '$1==m && ($2 FS $3)==k {print $4}' "$shacache" | tail -1)
  if [ -z "$gsha" ]; then
    gsha=$(sha256sum "$model" | cut -d' ' -f1)
    echo "$model $statkey $gsha" >> "$shacache"
  fi
  packdir=$cache/packs/$gsha
  pbuilt=0
  if [ "$rebuild" = 1 ] || [ ! -s "$packdir/index.txt" ]; then
    pbuilt=1
    pbuild0=$(date +%s)
    packtool=$(kvget baro.run.pack.tool); packtool=${packtool:-engine-pack.py}
    packflags=$(kvget baro.run.pack.flags)
    packsrc=$cache/pack-src; mkdir -p "$packsrc"
    jq -er --arg k "baro.run.src.$packtool" '.[$k]' "$meta" > "$packsrc/$packtool" 2>/dev/null \
      || { echo "pack tool: file carries no baro.run.src.$packtool, using the checkout's tools/$packtool"; cp "$here/tools/$packtool" "$packsrc/$packtool"; }
    jq -er '.["baro.run.src.gguf-extract.py"]' "$meta" > "$packsrc/gguf-extract.py" 2>/dev/null \
      || cp "$here/tools/gguf-extract.py" "$packsrc/gguf-extract.py"
    rm -rf "$packdir.new"; mkdir -p "$packdir.new"
    echo "building pack ($packtool ${packflags:-<no flags>}) ..."
    # shellcheck disable=SC2086
    "$py" "$packsrc/$packtool" "$model" "$packdir.new" $packflags > "$cache/pack.log" 2>&1 \
      || { tail -5 "$cache/pack.log"; die "pack build FAILED, see $cache/pack.log"; }
    rm -rf "$packdir"; mv "$packdir.new" "$packdir"
    pbuild_s=$(( $(date +%s) - pbuild0 ))
    echo "pack: built in ${pbuild_s}s -> $packdir ($(wc -l < "$packdir/index.txt") tensors)"
  fi
  echo "pack: $([ $pbuilt = 1 ] && echo miss || echo hit) $packdir ($(wc -l < "$packdir/index.txt") tensors)"

  # Text endpoints need tokenizer.json + tokenizer-meta.json in the pack. Built
  # from the GGUF by tools/gguf-tokenizer-json.mojo (byte-level BPE); for any
  # other tokenizer (SPM, spark2_5) the meta is still written and a shipped
  # hf/tokenizer.json next to the model is copied in.
  if [ ! -s "$packdir/tokenizer.json" ] || [ ! -s "$packdir/tokenizer-meta.json" ]; then
    tj=$here/.work/gguf-tokenizer-json
    [ -x "$tj" ] || "$here/.venv/bin/mojo" build "$here/tools/gguf-tokenizer-json.mojo" -I "$here" -I "$here/serve" -o "$tj" > "$work/tokjson-build.log" 2>&1 \
      || die "tokenizer tool build FAILED, see $work/tokjson-build.log"
    if ! "$tj" "$model" "$packdir" > "$work/tokjson.log" 2>&1; then
      shipped=$(dirname "$model")/hf/tokenizer.json
      if [ -s "$shipped" ]; then
        cp "$shipped" "$packdir/tokenizer.json"
        echo "tokenizer: $(head -1 "$work/tokjson.log"); copied $shipped"
      else
        echo "tokenizer: none ($(head -1 "$work/tokjson.log")); text endpoints will return 503, token-id requests work"
      fi
    fi
  fi
  [ -s "$packdir/tokenizer.json" ] && echo "tokenizer: $packdir/tokenizer.json"

  total_s=$(( $(date +%s) - t0 ))
  echo "receipt: id=$id engine=$([ $built = 1 ] && echo miss || echo hit) pack=$([ $pbuilt = 1 ] && echo miss || echo hit) elapsed_s=$total_s"

  [ $serve = 1 ] || { echo "--no-serve: stopping after build"; exit 0; }
  bs=$here/serve/target/release/baro-serve
  if [ ! -x "$bs" ]; then
    echo "baro-serve is not built; building it (needs cargo) ..."
    cargo build --release --manifest-path "$here/serve/Cargo.toml" > "$work/cargo.log" 2>&1 \
      || die "cargo build FAILED, see $work/cargo.log"
  fi
  renv=$(kvget baro.run.env)
  [ -z "$renv" ] || echo "env from the file: $renv"
  echo "self-reported: every tok/s this server prints came from the harness the"
  echo "self-reported: model file carries, not from a harness a verifier chose."
  server_args=(--engine "$cache/engine" --pack "$packdir" --port "$port")
  [ -z "$chat_template_file" ] || server_args+=(--chat-template-file "$chat_template_file")
  # shellcheck disable=SC2086
  exec env $renv "$bs" "${server_args[@]}"
  ;;

run)
  # Run mode needs the harness FROM THE FILE. Without it there is nothing to
  # build a runnable engine from, and taking it from git would make this mode
  # need the checkout, which is exactly what it exists to avoid.
  src=$work/src
  rm -rf "$src"; mkdir -p "$src"
  harness=$(jq -r '.["baro.run.src.engine.mojo"] // empty' "$meta")
  [ -n "$harness" ] || die "this file carries no baro.run.src.engine.mojo, so it cannot run itself; use: baro verify $model"
  printf '%s' "$harness" > "$src/engine.mojo"
  jq -r '.["baro.kernel.files"]' "$meta" | tr ',' '\n' > "$src/FILES"
  while read -r f; do
    [ -n "$f" ] || continue
    mkdir -p "$src/$(dirname "$f")"
    jq -r --arg k "baro.kernel.src.$f" '.[$k]' "$meta" > "$src/$f"
  done < "$src/FILES"
  # The harness's own serve-module closure (prefix, harness, moe_pack, latent,
  # ...) rides in baro.run.src.*.mojo beside it. tools/gguf-closure.sh gets
  # these from git at the gguf's commit; run mode has no checkout to get them
  # from, and without them the build stops at "unable to locate module".
  extra=0
  for k in $(jq -r 'keys[] | select(startswith("baro.run.src.")) | select(endswith(".mojo"))' "$meta"); do
    n=${k#baro.run.src.}
    [ "$n" = "engine.mojo" ] && continue
    jq -r --arg k "$k" '.[$k]' "$meta" > "$src/$n"
    extra=$((extra + 1))
  done
  echo "sources: $(wc -l < "$src/FILES") kernel files, $extra serve modules, plus the run harness, all from $model"

  mojo=$here/.venv/bin/mojo
  [ -x "$mojo" ] || die "no $mojo; run 'uv sync' in the checkout first (the pinned toolchain is max[all]==26.5.0)"
  dflag=""; [ -n "$kmodel" ] && dflag="-D BARO_MODEL=$kmodel"
  # An engine already built from THIS file's harness is reused. Compiling is
  # minutes of CPU, and the GPU rule (docs/NEXT-PLAN.md) says a gate holds the
  # card for minutes, not for a build: `baro run --no-serve` does the CPU half
  # outside any GPU reservation, then the serving call reuses what it made.
  esha=$(kvget baro.run.harness.sha)
  if [ -x "$work/engine" ] && [ -n "$esha" ] && [ "$(cat "$work/engine.harness.sha" 2>/dev/null)" = "$esha" ]; then
    echo "engine: reusing $work/engine (built from this file's harness ${esha:0:16})"
  else
    echo "building engine (model ${kmodel:-qwen35}) ..."
    # shellcheck disable=SC2086
    "$mojo" build "$src/engine.mojo" -I "$src" $dflag -o "$work/engine" > "$work/build.log" 2>&1
    [ -x "$work/engine" ] || { grep -m3 error "$work/build.log"; die "engine build FAILED, see $work/build.log"; }
    printf '%s' "$esha" > "$work/engine.harness.sha"
  fi
  echo "engine: $work/engine  sha256 $(sha256sum "$work/engine" | cut -c1-16)"

  if [ -z "$pack" ]; then
    pack=$work/pack
    if [ ! -s "$pack/index.txt" ]; then
      flags=$(kvget baro.run.pack.flags)
      packer=$work/engine-pack.py
      if jq -er '.["baro.run.src.engine-pack.py"]' "$meta" > "$packer" 2>/dev/null; then
        # engine-pack.py loads gguf-extract.py from its own directory.
        jq -er '.["baro.run.src.gguf-extract.py"]' "$meta" > "$work/gguf-extract.py" 2>/dev/null \
          || cp "$here/tools/gguf-extract.py" "$work/gguf-extract.py"
      else
        packer=$here/tools/engine-pack.py
        echo "pack tool: from the checkout (the file carries none)"
      fi
      echo "building pack from $model with flags '${flags:-none}' (minutes, CPU) ..."
      # shellcheck disable=SC2086
      "$py" "$packer" "$model" "$pack" $flags > "$work/pack.log" 2>&1 \
        || { tail -5 "$work/pack.log"; die "pack build FAILED, see $work/pack.log"; }
    fi
  fi
  echo "pack: $pack ($(wc -l < "$pack/index.txt") tensors)"

  [ $serve = 1 ] || { echo "--no-serve: stopping after build"; exit 0; }
  bs=$here/serve/target/release/baro-serve
  if [ ! -x "$bs" ]; then
    echo "baro-serve is not built; building it (needs cargo) ..."
    cargo build --release --manifest-path "$here/serve/Cargo.toml" > "$work/cargo.log" 2>&1 \
      || die "cargo build FAILED, see $work/cargo.log"
  fi
  # The env the file says this model needs (baro.run.env). Without it the MoE
  # profile dies on the engine's own BARO_MEGA=1 default before its ready line.
  renv=$(kvget baro.run.env)
  [ -z "$renv" ] || echo "env from the file: $renv"
  echo "self-reported: every tok/s this server prints came from the harness the"
  echo "self-reported: model file carries, not from a harness a verifier chose."
  echo "self-reported: to produce a citable number run: tools/baro verify $model --append"
  server_args=(--engine "$work/engine" --pack "$pack" --port "$port")
  [ -z "$chat_template_file" ] || server_args+=(--chat-template-file "$chat_template_file")
  # shellcheck disable=SC2086
  exec env $renv "$bs" "${server_args[@]}"
  ;;

*)
  die "unknown command $cmd (serve, run, verify, receipts, eval, eval-all, multi-serve)"
  ;;
esac
